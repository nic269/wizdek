{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["clientSafeEntrypoints", "packageRules"],
  "properties": {
    "$schema": { "type": "string" },
    "clientSafeEntrypoints": { "$ref": "#/$defs/stringArrayMap" },
    "packageRules": { "$ref": "#/$defs/stringArrayMap" },
    "forbiddenPackageImports": { "$ref": "#/$defs/stringArrayMap" },
    "forbiddenImportExceptions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\*])[^/]+(?:/[^/]+)*$"
        },
        "additionalProperties": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "stringArrayMap": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "uniqueItems": true
      }
    }
  }
}
