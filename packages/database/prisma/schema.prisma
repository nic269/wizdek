generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum JobRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

enum FileVisibility {
  PRIVATE
  PUBLIC
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  status        UserStatus @default(ACTIVE)
  isSuperAdmin  Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions        Session[]
  accounts        Account[]
  memberships     Membership[]
  auditLogs       AuditLog[]   @relation("AuditActor")
  invitationsSent Invitation[] @relation("InvitationInviter")
  files           FileAsset[]  @relation("FileOwner")

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships         Membership[]
  roles               Role[]
  invitations         Invitation[]
  auditLogs           AuditLog[]
  files               FileAsset[]
  integrations        IntegrationConnection[]
  jobs                JobRun[]
  shopifyApps         ShopifyApp[]
  shopifyStores       ShopifyStore[]
  savedGraphqlQueries SavedGraphqlQuery[]
  flows               Flow[]
  flowRuns            FlowRun[]
  databaseConnections DatabaseConnection[]
  databaseBackups     DatabaseBackup[]

  @@map("organization")
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  roleId         String?
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("membership")
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  Membership[]
  invitations  Invitation[]

  @@unique([organizationId, name])
  @@map("role")
}

model RolePermission {
  id        String   @id @default(cuid())
  roleId    String
  module    String
  action    String
  createdAt DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module, action])
  @@map("role_permission")
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  roleId         String?
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  role         Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
  @@index([status, expiresAt])
  @@map("invitation")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        String?
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_log")
}

model FileAsset {
  id             String         @id @default(cuid())
  organizationId String?
  ownerId        String?
  provider       String
  bucket         String?
  objectKey      String
  fileName       String
  contentType    String
  sizeBytes      BigInt
  visibility     FileVisibility @default(PRIVATE)
  checksum       String?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  owner        User?         @relation("FileOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("file_asset")
}

model WebhookEvent {
  id           String             @id @default(cuid())
  provider     String
  eventType    String
  externalId   String?
  status       WebhookEventStatus @default(RECEIVED)
  payload      Json
  receivedAt   DateTime           @default(now())
  processedAt  DateTime?
  errorMessage String?

  @@unique([provider, externalId])
  @@index([provider, eventType, receivedAt])
  @@index([status, receivedAt])
  @@map("webhook_event")
}

model JobRun {
  id             String       @id @default(cuid())
  organizationId String?
  scopeKey       String       @default("global")
  name           String
  status         JobRunStatus @default(QUEUED)
  idempotencyKey String?
  payload        Json?
  progress       Int          @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  logs         JobLog[]

  @@unique([scopeKey, name, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([status, createdAt])
  @@map("job_run")
}

model JobLog {
  id        String   @id @default(cuid())
  runId     String
  level     String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  run JobRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@map("job_log")
}

model IntegrationConnection {
  id             String   @id @default(cuid())
  organizationId String?
  provider       String
  externalId     String?
  displayName    String
  status         String   @default("DISABLED")
  config         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, externalId])
  @@index([organizationId, provider])
  @@map("integration_connection")
}

model FeatureFlag {
  id        String   @id @default(cuid())
  scopeId   String   @default("global")
  key       String
  enabled   Boolean  @default(false)
  payload   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scopeId, key])
  @@map("feature_flag")
}

enum ShopifyCredentialStrategy {
  STATIC_TOKEN
  OAUTH
  CLIENT_CREDENTIALS
}

enum ShopifyStoreStatus {
  PENDING
  CONNECTED
  RECONNECT_REQUIRED
  DISCONNECTED
}

/// Which kind of environment a store or database is, shown as a risk signal
/// next to its name. Writes against PROD ask for confirmation.
enum TargetEnvironment {
  PROD
  STAGING
  DEV
}

enum ShopifyTokenMode {
  NON_EXPIRING
  EXPIRING
}

model ShopifyApp {
  id                    String           @id @default(cuid())
  organizationId        String
  name                  String
  clientId              String
  clientSecretEncrypted String           @db.Text
  scopes                String[]
  installLink           String?          @db.Text
  tokenMode             ShopifyTokenMode @default(NON_EXPIRING)
  createdById           String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stores       ShopifyStore[]

  @@unique([organizationId, clientId])
  @@map("shopify_app")
}

model ShopifyStore {
  id                     String                    @id @default(cuid())
  organizationId         String
  appId                  String?
  shopDomain             String
  name                   String
  strategy               ShopifyCredentialStrategy
  status                 ShopifyStoreStatus        @default(PENDING)
  environment            TargetEnvironment         @default(DEV)
  scopes                 String[]
  apiVersion             String
  currencyCode           String?
  connectedAt            DateTime?
  lastHealthCheckAt      DateTime?
  lastHealthCheckError   String?                   @db.Text
  // Signs webhooks for stores connected by a pasted token, which have no app.
  webhookSecretEncrypted String?                   @db.Text
  createdById            String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  app             ShopifyApp?         @relation(fields: [appId], references: [id], onDelete: Restrict)
  tokens          ShopifyToken[]
  oauthStates     ShopifyOAuthState[]
  flowRuns        FlowRun[]
  flowActivations FlowActivation[]

  @@unique([organizationId, shopDomain])
  @@unique([id, organizationId])
  @@index([appId])
  @@map("shopify_store")
}

model ShopifyToken {
  id                    String    @id @default(cuid())
  storeId               String
  accessTokenEncrypted  String    @db.Text
  refreshTokenEncrypted String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scopes                String[]
  rotatedAt             DateTime?
  revokedAt             DateTime?
  createdAt             DateTime  @default(now())

  store ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, revokedAt])
  @@map("shopify_token")
}

model ShopifyOAuthState {
  id              String    @id @default(cuid())
  storeId         String
  stateHash       String    @unique
  createdByUserId String
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  store ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("shopify_oauth_state")
}

model SavedGraphqlQuery {
  id             String   @id @default(cuid())
  organizationId String
  createdById    String?
  name           String
  query          String   @db.Text
  variables      String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@map("saved_graphql_query")
}

enum FlowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum FlowRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIALLY_FAILED
  FAILED
  CANCELED
}

enum FlowStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum FlowItemStatus {
  PENDING
  IN_PROGRESS
  SUCCEEDED
  FAILED
  UNKNOWN
}

model Flow {
  id               String     @id @default(cuid())
  organizationId   String
  name             String
  description      String?
  status           FlowStatus @default(DRAFT)
  currentVersionId String?
  createdById      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     FlowVersion[]
  runs         FlowRun[]
  activations  FlowActivation[]

  @@index([organizationId, updatedAt])
  @@map("flow")
}

model FlowVersion {
  id          String   @id @default(cuid())
  flowId      String
  version     Int
  definition  Json
  createdById String?
  createdAt   DateTime @default(now())

  flow        Flow             @relation(fields: [flowId], references: [id], onDelete: Cascade)
  runs        FlowRun[]
  activations FlowActivation[]

  @@unique([flowId, version])
  @@map("flow_version")
}

model FlowRun {
  id                String        @id @default(cuid())
  organizationId    String
  flowId            String
  flowVersionId     String
  storeId           String
  /// Counts the flow's runs from 1, for display as "Run #12".
  number            Int
  status            FlowRunStatus @default(QUEUED)
  triggerType       String
  triggerPayload    Json?
  itemCount         Int           @default(0)
  startedById       String?
  startedAt         DateTime?
  completedAt       DateTime?
  cancelRequestedAt DateTime?
  error             Json?
  createdAt         DateTime      @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  flow         Flow          @relation(fields: [flowId], references: [id], onDelete: Cascade)
  flowVersion  FlowVersion   @relation(fields: [flowVersionId], references: [id], onDelete: Cascade)
  store        ShopifyStore  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  steps        FlowRunStep[]
  items        FlowRunItem[]

  @@unique([flowId, number])
  @@index([flowId, createdAt])
  @@index([organizationId, createdAt])
  @@map("flow_run")
}

model FlowRunStep {
  id          String         @id @default(cuid())
  runId       String
  nodeId      String
  nodeType    String
  status      FlowStepStatus @default(PENDING)
  state       Json?
  error       Json?
  startedAt   DateTime?
  completedAt DateTime?

  run FlowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, nodeId])
  @@map("flow_run_step")
}

model FlowRunItem {
  id           String         @id @default(cuid())
  // Insertion order, so a node's items are processed in the order they arrived.
  ordinal      Int            @default(autoincrement())
  runId        String
  nodeId       String
  itemKey      String
  status       FlowItemStatus @default(PENDING)
  input        Json
  output       Json?
  outputHandle String?
  error        Json?
  attempts     Int            @default(0)
  durationMs   Int?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  run FlowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, nodeId, itemKey])
  @@index([runId, nodeId, status, ordinal])
  @@map("flow_run_item")
}

enum FlowActivationStatus {
  ACTIVE
  FAILED
  INACTIVE
}

model FlowActivation {
  id                    String               @id @default(cuid())
  flowId                String
  storeId               String
  flowVersionId         String
  status                FlowActivationStatus
  webhookSubscriptionId String?
  error                 String?              @db.Text
  activatedById         String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  flow        Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  store       ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  flowVersion FlowVersion  @relation(fields: [flowVersionId], references: [id], onDelete: Cascade)

  @@unique([flowId, storeId])
  @@index([storeId])
  @@map("flow_activation")
}

enum DatabaseEngine {
  POSTGRESQL
}

enum DatabaseBackupStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

/// A database the organization can run tools against. The URL, password
/// included, is stored only encrypted; the other columns are for display.
model DatabaseConnection {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  engine         DatabaseEngine
  environment    TargetEnvironment @default(DEV)
  urlEncrypted   String         @db.Text
  host           String
  port           Int
  databaseName   String
  username       String
  /// The URL's sslmode parameter, kept for display; null when it has none.
  sslMode        String?
  serverVersion  String?
  lastCheckedAt  DateTime?
  lastCheckError String?        @db.Text
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  backups      DatabaseBackup[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@map("database_connection")
}

/// One backup attempt. Kept, with its file, after the connection is deleted.
model DatabaseBackup {
  id              String               @id @default(cuid())
  organizationId  String
  connectionId    String?
  connectionName  String
  engine          DatabaseEngine
  databaseName    String
  status          DatabaseBackupStatus @default(QUEUED)
  storageProvider String?
  objectKey       String?
  fileName        String?
  sizeBytes       BigInt?
  checksumSha256  String?
  toolVersion     String?
  serverVersion   String?
  error           String?              @db.Text
  requestedById   String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   DatabaseConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([connectionId, createdAt])
  @@index([status, startedAt])
  @@map("database_backup")
}
