    "test:integration": "vitest run integration",
    "fake-runner": "tsx src/testing/run-fake-runner.ts"
  },
  "dependencies": {
    "@repo/database": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.1.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
