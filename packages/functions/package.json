{
  "name": "@repo/functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./definition": "./src/definition/index.ts",
    "./testing": "./src/testing/fake-runner.ts"
  },
  "scripts": {
    "build": "echo '@repo/functions is source-only'",
    "check-types": "tsc --noEmit",
    "test": "vitest run --exclude 'integration/**' --passWithNoTests",
