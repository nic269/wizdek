# Core local URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3002
APP_INTERNAL_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:3002

# Required core services
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopify_toolkit
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3002/api/auth

# Optional auth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional mail: leave blank locally to write to MAIL_OUTBOX_DIR.
# Production auth-email features require a configured Resend or SMTP provider.
MAIL_PROVIDER=
MAIL_OUTBOX_DIR=.data/mail
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_URL=
SMTP_FROM_EMAIL=

# Optional billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Optional observability and analytics
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# Optional CMS
CMS_TOKEN=

# Optional storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=

# Shopify: SHOPIFY_TOKEN_ENCRYPTION_KEY encrypts every stored store credential.
# Back it up with the database; losing or changing it makes them unreadable.
SHOPIFY_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
# Optional Admin API version (YYYY-MM); defaults to the version pinned in @repo/shopify.
SHOPIFY_API_VERSION=
# Test-only: sends every Shopify request to this origin. Refused in production.
SHOPIFY_ADMIN_BASE_URL_OVERRIDE=
