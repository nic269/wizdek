{
  "name": "@repo/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev --port 4000",
    "build": "dotenv -e ../../.env -- next build",
    "start": "next start --port ${PORT:-3000}",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude \"app/works/oms-management/_module/tests/e2e/**\"",
    "test:unit": "vitest run --passWithNoTests --exclude \"app/works/oms-management/_module/tests/e2e/**\" --exclude \"app/works/oms-management/_module/tests/integration/**\"",
    "test:integration": "echo 'no app integration tests yet'",
    "test:oms": "vitest run app/works/oms-management/_module/tests/unit",
    "test:oms:integration": "vitest run app/works/oms-management/_module/tests/integration",
    "check:oms-isolation": "tsx app/works/oms-management/_module/scripts/check-isolation.ts",
    "test:oms:e2e": "playwright test --config app/works/oms-management/_module/playwright.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1063.0",
    "@graphiql/plugin-explorer": "^5.1.5",
    "@graphiql/react": "0.39.1",
    "@repo/access-control": "workspace:*",
    "@repo/api": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/config": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/design-system": "workspace:*",
    "@repo/flows": "workspace:*",
    "@repo/functions": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.2",
    "@xyflow/react": "^12.12.0",
    "croner": "9.1.0",
    "graphiql": "^5.4.0",
    "graphql": "^16.14.2",
    "monaco-editor": "0.52.2",
    "next": "^16.2.10",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
