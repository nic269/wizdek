# Configure in Wizdek root .env or apps/app runtime environment. No separate app server.
# Runtime-only; never pass OMS credentials to another Wizdek app or NEXT_PUBLIC_*.
OMS_PUBLIC_URL=https://wizdek.example.com
OMS_CONTROL_DB_PATH=/data/control.sqlite
# Generate independently: openssl rand -base64 32
OMS_PROFILE_ENCRYPTION_KEY=
OMS_ALLOWED_WIZDEK_USER_IDS=
# Allowlist grants READ only. Explicit capabilities are required for all other actions.
OMS_ACCESS_POLICY_JSON=[]
# Single-operator example: [{"userId":"stable-wizdek-id","profiles":["staging","production","custom"],"capabilities":["read","profiles:edit","settings:write","commands","secrets:reveal"]}]
OMS_PROFILE_SCOPES_JSON={"staging":{"accountIds":[],"globalDiagnostics":true},"production":{"accountIds":[],"globalDiagnostics":true},"custom":{"accountIds":[],"globalDiagnostics":true}}
# Optional restrictions. Empty lists accept destinations entered by the authorized operator.
OMS_ALLOWED_DB_HOSTS=
OMS_ALLOWED_DB_PORTS=
OMS_ALLOWED_API_ORIGINS=
# Optional operator-owned production classification anchors; NOT required for API pairing.
# DB/API matching uses automatic fingerprints. Direct DB settings/catalog/downloads do not call the API.
# [{"host":"stage-db.example.com","port":5432,"database":"oms","databaseIdentity":"UUID","deploymentId":"oms-stage","apiOrigin":"https://stage-api.example.com","safetyClass":"staging"}]
OMS_TARGET_BINDINGS_JSON=[]
OMS_POOL_LIMIT=4
OMS_WRITES_ENABLED=false
OMS_BACKUP_EVIDENCE_JSON={}
# Per-profile operator evidence: {"staging":{"databaseFingerprint":"64-char-sha256","databaseIdentity":"UUID","backupReference":"backup-system/ref","restoreVerifiedAt":"2026-11-14T00:00:00.000Z","expiresAt":"2026-11-15T00:00:00.000Z"}}
OMS_ALLOW_LOCAL_CONNECTIONS=false
# Optional presets. API connection requires only URL + service token.
OMS_STAGING_DATABASE_URL=
OMS_STAGING_API_URL=
OMS_STAGING_SERVICE_TOKEN=
OMS_STAGING_ACCOUNT_IDS=
OMS_STAGING_GLOBAL_DIAGNOSTICS=true
OMS_PRODUCTION_DATABASE_URL=
OMS_PRODUCTION_API_URL=
OMS_PRODUCTION_SERVICE_TOKEN=
OMS_PRODUCTION_ACCOUNT_IDS=
OMS_PRODUCTION_GLOBAL_DIAGNOSTICS=true
# If RDS/private CA is required, mount a trusted PEM and configure NODE_EXTRA_CA_CERTS.

# Direct resources, keyed by databaseFingerprint(connection). Keep values server-side.
# encryptionKey must equal the OMS token-encryption secret; it is NOT the profile encryption key.
# storage.prefix is required and must match the selected environment's object key prefix.
# credentials may be omitted to use the AWS SDK credential provider chain.
# {"64-char-sha256":{"encryptionKey":"OMS-token-encryption-key","storage":{"region":"ap-southeast-1","bucket":"private-oms","prefix":"staging","credentials":{"accessKeyId":"...","secretAccessKey":"..."}}}}
# R2/S3-compatible storage may additionally set endpoint (HTTPS) and forcePathStyle.
OMS_DIRECT_RESOURCES_JSON={}
